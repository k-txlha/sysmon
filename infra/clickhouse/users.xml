<clickhouse>
    <profiles>
        <!-- Backend API: read + alert mutation only. No DDL. -->
        <backend_prof>
            <max_execution_time>5</max_execution_time>
            <max_memory_usage>2147483648</max_memory_usage>
            <readonly>0</readonly>
        </backend_prof>
        <!-- Worker: needs DDL to run init_db() on startup, plus inserts. -->
        <worker_prof>
            <max_execution_time>30</max_execution_time>
            <max_memory_usage>2147483648</max_memory_usage>
            <readonly>0</readonly>
        </worker_prof>
    </profiles>

    <users>
        <!-- Backend API user: SELECT + INSERT (for ALTER TABLE mutations) only. -->
        <backend>
            <password_sha256_hex>6d0807a09c92f8786264574f1b9380bee5ee9450e8eae16db1873352d9c20c0f</password_sha256_hex>
            <profile>backend_prof</profile>
            <grants>
                <query>GRANT SELECT ON metrics.*</query>
                <query>GRANT ALTER UPDATE ON metrics.*</query>
            </grants>
        </backend>

        <!-- Worker user: INSERT + CREATE TABLE for schema init, no SELECT needed. -->
        <worker>
            <password_sha256_hex>0aa00c71608c5451bb7656ef8b147206708ec420fa183eb7423b526743cd5eab</password_sha256_hex>
            <profile>worker_prof</profile>
            <grants>
                <query>GRANT SELECT ON metrics.*</query>
                <query>GRANT INSERT ON metrics.*</query>
                <query>GRANT CREATE TABLE ON metrics.*</query>
            </grants>
        </worker>
    </users>
</clickhouse>